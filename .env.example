# ──────────────────────────────────────────────────────────────────────────
# StudyBuddy AI — Environment Variables (template)
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is the
# ONE env file the project uses; it is gitignored via "*.local".
#
# Two rules:
#   • VITE_* is compiled into the browser bundle — anyone can read it. Only
#     public keys belong here.
#   • Everything else is server-only and must never gain a VITE_ prefix.
# ──────────────────────────────────────────────────────────────────────────


# ══ CLIENT (compiled into the browser bundle) ═════════════════════════════

# From Supabase Dashboard → Project Settings → API.
# The anon key is safe in the browser — Row Level Security protects the data.
# REQUIRED: the production build fails without these, by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Your custom domain, used to build OAuth / email redirect URLs.
# Leave blank to use whatever origin the app is served from.
# Whatever you set MUST be listed in Supabase → Authentication → URL
# Configuration → Redirect URLs, or sign-in callbacks are rejected.
VITE_SITE_URL=

# Set to "true" to hard-redirect every other origin (e.g. the raw *.vercel.app
# URL) to VITE_SITE_URL. Leave it false until that domain is CONFIRMED to serve
# this app — pointing it at a parked/undelegated domain sends 100% of traffic
# to a dead page. Prefer Vercel → Settings → Domains → "Redirect to" instead.
VITE_ENFORCE_CANONICAL_DOMAIN=false

# Optional client error tracing. Blank = Sentry never loads.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1


# ══ SERVER (used only by /api functions — never sent to the browser) ══════

# Service-role key BYPASSES Row Level Security. Server-only, always.
# Used by admin-delete-user, send-weekly-emails, and token verification.
#
# If you connect the Vercel↔Supabase integration, it injects SUPABASE_URL and
# SUPABASE_SECRET_KEY automatically — the code accepts SUPABASE_SECRET_KEY as
# an alias, so you do NOT need to set SUPABASE_SERVICE_ROLE_KEY as well.
# Note the integration does NOT provide any VITE_* variables: the two client
# vars above must still be set by hand, or the production build fails.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Groq — powers summaries, takeaways, quizzes, and the AI tutor.
GROQ_API_KEY=

# YouTube summarizer.
# Supadata ("sd_…") fetches captions — it isn't blocked by YouTube's
# anti-scraping checks, unlike scraping from Vercel's shared IPs.
SUPADATA_API_KEY=
# A real YouTube Data API v3 key ("AIza…") for video metadata. Without it the
# code falls back to public oEmbed: title and author work, duration does not.
YOUTUBE_API_KEY=

# Weekly email digest (Resend).
RESEND_API_KEY=
RESEND_FROM=
# Absolute base URL for links inside those emails.
PUBLIC_APP_URL=
# If set, /api/send-weekly-emails requires: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
