# ──────────────────────────────────────────────────────────────────────────
# StudyBuddy AI — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` (it is gitignored).
# ──────────────────────────────────────────────────────────────────────────

# ── Supabase (client) ──────────────────────────────────────────────────────
# From Supabase Dashboard → Project Settings → API.
# The anon key is safe in the browser — Row-Level Security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Canonical site URL ─────────────────────────────────────────────────────
# Your custom domain, used to build OAuth / email redirect URLs.
# Leave blank for local dev (falls back to window.location.origin).
# Whatever you set MUST be listed in Supabase → Authentication → URL
# Configuration → Redirect URLs, or sign-in callbacks are rejected.
VITE_SITE_URL=

# Set to "true" to hard-redirect every other origin (e.g. the raw *.vercel.app
# URL) to VITE_SITE_URL. Leave it false until that domain is CONFIRMED to serve
# this app — pointing it at a parked/undelegated domain sends 100% of traffic
# to a dead page. Prefer Vercel → Settings → Domains → "Redirect to" instead.
VITE_ENFORCE_CANONICAL_DOMAIN=false

# ── Error monitoring (client, optional) ────────────────────────────────────
# Leave blank to disable Sentry in local development.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ── AI (server-side only — never exposed to the browser) ───────────────────
# Groq API key used by the /api/groq proxy.
GROQ_API_KEY=

# ── Supabase (server-side, for /api functions) ─────────────────────────────
# Service-role key BYPASSES RLS — keep it server-only, never VITE_-prefixed.
# Used by admin-delete-user, send-weekly-emails, and token verification.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── YouTube transcript / summarizer (server-side) ──────────────────────────
# YouTube Data API key (for video metadata) and Supadata key (for transcripts).
YOUTUBE_API_KEY=
SUPADATA_API_KEY=

# ── Weekly email digest (server-side, Resend) ──────────────────────────────
RESEND_API_KEY=
RESEND_FROM=
# Secret that protects the /api/send-weekly-emails cron endpoint.
CRON_SECRET=
