# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.tsbuildinfo
*.local
.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Project custom exclusions
development/
developments/
!developments/*.md

# Scratch/test scripts
scratch/

# Playwright harness screenshot output. flows.mjs names its output directory
# from an env var; with that unset the path becomes the literal string
# "undefined", so a stray undefined/ of PNGs appears after a local run.
undefined/

# Codex automation artifacts
.codex-*

# Claude Code local state. Ignored wholesale because .claude/worktrees/ holds
# full checkouts — including .env.local and dist/ — that a `git add -A` would
# otherwise sweep into a commit. launch.json is re-included: it is a shared
# dev-server config with nothing sensitive in it.
.claude/*
!.claude/launch.json

# Python reference library (not part of the build)

.vercel
