rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        )) ||
        (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.is_admin == true ||
          get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == "admin"
        ))
      );
    }

    function isOwner() {
      return isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    function isNewOwner() {
      return isAuthenticated() && request.resource.data.user_id == request.auth.uid;
    }

    // ── /users collection ─────────────────────────────
    // SECURITY: the `users` collection is the source of truth for admin status
    // (is_admin / role), and isAdmin() trusts it. The client only ever READS
    // this collection, so write/delete are locked to admins (provisioned via
    // the Firebase Console, which bypasses rules). This closes the privilege-
    // escalation hole where a user could write { is_admin: true } to their own
    // /users/{uid} doc and instantly become an administrator.
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow write: if isAdmin();
      allow delete: if isAdmin();

      match /profile_data/{document=**} {
        allow read, write: if isUser(userId);
        allow delete: if isUser(userId) || isAdmin();
      }
    }

    // ── /profiles collection ──────────────────────────
    // SECURITY: profiles are self-writable (signup, onboarding, XP, etc.), but
    // a user must NEVER be able to grant themselves admin by writing is_admin
    // or role onto their own profile. Those two fields are blocked on create
    // and update for normal users; only an admin may change them.
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isUser(userId)
        && !request.resource.data.keys().hasAny(['is_admin', 'role']);
      allow update: if isAdmin() || (
        isUser(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['is_admin', 'role'])
      );
      // FIX Bug 16: Admin can now delete profiles (was missing — caused errors
      // in AdminPanel when trying to remove users).
      allow delete: if isUser(userId) || isAdmin();
    }

    // ── /user_preferences collection ──────────────────
    match /user_preferences/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow write: if isUser(userId);
      // FIX Bug 16: Admin can now delete user_preferences (was missing).
      allow delete: if isUser(userId) || isAdmin();
    }

    // ── /study_sessions collection ────────────────────
    match /study_sessions/{sessionId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isNewOwner();
      allow update: if isOwner();
      allow delete: if isOwner() || isAdmin();
    }

    // ── /xp_logs collection ───────────────────────────
    // READ is open to any signed-in user so the leaderboard can aggregate
    // today / this-week / all-time XP across users (xp amounts are not private).
    // Writes stay owner-only so nobody can fabricate XP for someone else.
    match /xp_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isNewOwner();
      allow update: if isOwner();
      allow delete: if isOwner() || isAdmin();
    }

    // ── /user_streaks collection ──────────────────────
    match /user_streaks/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow write: if isUser(userId);
      allow delete: if isUser(userId) || isAdmin();
    }

    // ── /lesson_progress collection ───────────────────
    // SECURITY: was wide open to any authenticated user. Locked to the owner —
    // every lesson_progress doc carries user_id (set in LessonViewer), and the
    // only client query filters by user_id.
    match /lesson_progress/{progressId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isNewOwner();
      allow update: if isOwner();
      allow delete: if isOwner() || isAdmin();
    }

    // ── /quiz_attempts collection ─────────────────────
    match /quiz_attempts/{attemptId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isNewOwner();
      allow update: if isOwner();
      allow delete: if isAdmin();
    }

    // ── /topics collection ─────────────────────────────
    // SECURITY: official/seeded topics may only be written by admins, so a
    // student can no longer delete or corrupt the shared curriculum. Users may
    // still create/manage their OWN custom topics (is_custom == true, owned by
    // them) for the "Create Course from YouTube / material" feature.
    match /topics/{topicId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (
        isAuthenticated()
        && request.resource.data.is_custom == true
        && request.resource.data.user_id == request.auth.uid
      );
      allow update, delete: if isAdmin() || (
        isAuthenticated()
        && resource.data.is_custom == true
        && resource.data.user_id == request.auth.uid
      );
    }

    // ── /lessons collection ─────────────────────────────
    // SECURITY: same model as topics. Official lessons (no is_custom/user_id)
    // are admin-only; custom lessons are stamped with is_custom + user_id at
    // creation so the owner can manage them without a parent-topic lookup.
    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (
        isAuthenticated()
        && request.resource.data.is_custom == true
        && request.resource.data.user_id == request.auth.uid
      );
      allow update, delete: if isAdmin() || (
        isAuthenticated()
        && resource.data.is_custom == true
        && resource.data.user_id == request.auth.uid
      );
    }

    // ── /friends_list collection ──────────────────────
    // SECURITY: only the two parties in a relationship may see or change it.
    // Each doc has requester_id + addressee_id; the client queries on those.
    match /friends_list/{friendId} {
      allow read: if isAuthenticated() && (
        resource.data.requester_id == request.auth.uid ||
        resource.data.addressee_id == request.auth.uid
      );
      allow create: if isAuthenticated()
        && request.resource.data.requester_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.requester_id == request.auth.uid ||
        resource.data.addressee_id == request.auth.uid
      );
    }

    // ── /doubt_sessions collection ──────────────────
    match /doubt_sessions/{sessionId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isNewOwner();
      allow update: if isOwner();
      allow delete: if isOwner() || isAdmin();
    }

    // ── /doubt_messages collection ──────────────────
    // SECURITY: was readable/deletable by ANY authenticated user, exposing every
    // student's private doubt Q&A. Each message now carries user_id (stamped at
    // creation in DoubtInput/AISolution) and reads are owner-scoped. The client
    // query filters by user_id so it remains permitted.
    match /doubt_messages/{messageId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isNewOwner();
      allow update: if false; // messages are immutable
      allow delete: if isOwner() || isAdmin();
    }

    // ── /analytics collection ─────────────────────────
    match /analytics/{userId} {
      allow read: if isUser(userId);
      allow write: if isUser(userId);
    }

    // ── /feedback collection ──────────────────────────
    // Owner + admin only. NOTE: feedback docs use the field name `userId`
    // (camelCase), NOT `user_id` — the generic isOwner() helper checks
    // `user_id`, which silently denied every read (FeedbackEnforcer kept
    // failing with permission-denied). This checks the correct field.
    match /feedback/{feedbackId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // ── /topic_progress collection ─────────────────────
    // FIX Bug 10: topic_progress was wide open — any authenticated user could read
    // any user's topic progress. Locked down to owner + admin only.
    match /topic_progress/{progressId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isNewOwner();
      allow update: if isOwner();
      allow delete: if isOwner() || isAdmin();
    }

    // ── /materials collection ─────────────────────────
    match /materials/{materialId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isNewOwner();
      allow update: if isOwner();
      allow delete: if isOwner() || isAdmin();
    }

    // ── /analytics_snapshots collection ────────────────
    match /analytics_snapshots/{snapshotId} {
      allow read: if isOwner();
      allow create: if isNewOwner();
      allow update: if isOwner();
    }

    // ── /quiz_results collection ──────────────────────
    match /quiz_results/{resultId} {
      allow read: if isOwner();
      allow create: if isNewOwner();
      allow update: if isOwner();
    }

    // ── /flashcards collection ────────────────────────
    match /flashcards/{cardId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isNewOwner();
      allow update: if isOwner();
      allow delete: if isOwner() || isAdmin();
    }

    // ── /study_plans collection ───────────────────────
    match /study_plans/{planId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isNewOwner();
      allow update: if isOwner();
      allow delete: if isOwner() || isAdmin();
    }

    // ── /parent_guidance collection ───────────────────
    // Owner-scoped notes; was wide open to any authenticated user (IDOR).
    match /parent_guidance/{noteId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isNewOwner();
      allow update: if isOwner();
      allow delete: if isOwner() || isAdmin();
    }

    // ── /saved_notes collection ───────────────────────
    match /saved_notes/{noteId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isNewOwner();
      allow update: if isOwner();
      allow delete: if isOwner() || isAdmin();
    }

    // ── /notifications collection ─────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      // Self notifications, or cross-user system notifications from a verified sender
      allow create: if isAuthenticated() && (
        request.resource.data.user_id == request.auth.uid ||
        (
          request.resource.data.from_user_id == request.auth.uid &&
          request.resource.data.type == "system" &&
          request.resource.data.user_id is string &&
          request.resource.data.user_id != request.auth.uid
        )
      );
      allow update: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }

    // ── /follows collection (Leaderboard follow feature) ──
    // BUG FIX: this collection had no rule, so Firestore's default-deny
    // silently blocked every follow/unfollow and the "following" list.
    match /follows/{followId} {
      // You can read follow edges you are part of (your follows + your followers)
      allow read: if isAuthenticated() && (
        resource.data.follower_id == request.auth.uid ||
        resource.data.following_id == request.auth.uid
      );
      // You may only create a follow as yourself, never following yourself
      allow create: if isAuthenticated()
        && request.resource.data.follower_id == request.auth.uid
        && request.resource.data.following_id is string
        && request.resource.data.following_id != request.auth.uid;
      // Only the follower can remove their own follow
      allow delete: if isAuthenticated() && resource.data.follower_id == request.auth.uid;
      // Follow edges are immutable — delete and recreate instead
      allow update: if false;
    }

    // ── /complaints collection ────────────────────────
    match /complaints/{complaintId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isNewOwner();
      allow update: if isOwner() || isAdmin();
      allow delete: if isAdmin();
    }

    // ── /complaint_history collection ─────────────────
    match /complaint_history/{historyId} {
      allow read: if isOwner() || isAdmin();
      allow create: if isNewOwner() || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}