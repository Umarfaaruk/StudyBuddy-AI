{
  "name": "studybuddy-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts && node scripts/generate-seo.mjs",
    "lint": "eslint --config eslint.config.js src",
    "preview": "vite preview --config vite.config.ts",
    "test:unit": "node tests/unit/diagnostic.test.mjs",
    "qa": "node tests/run-qa.mjs",
    "load:frontend": "node tests/run-load.mjs --mode frontend",
    "load:api": "node tests/run-load.mjs --mode api",
    "test:onboarding": "node tests/unit/onboarding.test.mjs",
    "test": "npm run test:unit && npm run test:onboarding",
    "verify": "node tests/verify-integrations.mjs",
    "build:only": "vite build --config vite.config.ts",
    "seo": "node scripts/generate-seo.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/react": "^8.55.2",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.2",
    "gsap": "^3.14.2",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "pdfjs-dist": "^4.4.168",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "recharts": "^2.15.4",
    "resend": "^6.12.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "youtube-transcript": "^1.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19"
  }
}
